# ==============================================================================
# Aurelia Estates - Environment Variable Template
# Copy this file to .env.local and populate with your own project credentials.
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO SOURCE CONTROL.
# ==============================================================================

# Supabase Public Configuration (Exposed to browser client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-jwt-payload-here

# Sole Master Admin Authentication (Server-side only, never prefixed with NEXT_PUBLIC_)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=YourHighEntropyStrongPasswordHere!

# Optional: Server Access Secret for privileged internal calls
# ADMIN_ACCESS_SECRET=your-internal-secret-token-here

